{
  "name": "recipe-generator-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:api": "pnpm --filter @recipe-generator/api dev",
    "predev:api": "rm -rf .wrangler/deploy",
    "predev:all": "rm -rf .wrangler/deploy",
    "dev:all": "pnpm --parallel --filter recipe-generator-web --filter @recipe-generator/api dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy:web": "pnpm run build && pnpm exec wrangler deploy",
    "deploy:api": "pnpm --filter @recipe-generator/api run deploy",
    "deploy:all": "pnpm run deploy:api && pnpm run deploy:web",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "better-auth": "^1.2.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "react-doctor": "^0.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
