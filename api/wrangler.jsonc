{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "recipe-generator-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://recipe-generator-web.torrezhectorb.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
