{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "recipe-generator-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "recipe-generator",
			"database_id": "5079f670-70bc-4274-bc03-e346577e51d1",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "http://localhost:3000,https://recipe-generator-web.torrezhectorb.workers.dev",
		"BETTER_AUTH_URL": "http://localhost:8787"
	},
	"observability": {
		"enabled": true
	}
}