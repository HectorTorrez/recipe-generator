{
  "name": "@recipe-generator/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --config wrangler.jsonc",
    "deploy": "pnpm exec wrangler deploy --config wrangler.jsonc",
    "types": "wrangler types",
    "db:create": "wrangler d1 create recipe-generator",
    "db:migrate:local": "wrangler d1 migrations apply recipe-generator --local",
    "db:migrate:remote": "wrangler d1 migrations apply recipe-generator --remote"
  },
  "dependencies": {
    "better-auth": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260306.0",
    "typescript": "^6.0.2",
    "wrangler": "^4.70.0"
  }
}
