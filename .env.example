# Local dev: direct API URL (optional — Vite proxy works without this)
VITE_API_URL=http://localhost:8787

# Production: set in .env.production (baked into client bundle at build time)
# VITE_API_URL=https://recipe-generator-api.<subdomain>.workers.dev

# API worker CORS: set in api/wrangler.jsonc vars.ALLOWED_ORIGINS
